{
  "name": "safi-born-smart-agent-factory",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "SAFI Service 017: Born-Smart Agent Factory",
  "scripts": {
    "build": "npm --prefix client run build",
    "dev": "npm --prefix client run dev",
    "setup": "npm ci && npm --prefix client ci && npm run build",
    "test": "node --test \"tests/*.test.mjs\"",
    "verify": "node factory.mjs verify",
    "start": "node --env-file-if-exists=.env server/index.mjs",
    "test:live": "node --env-file-if-exists=.env --test \"tests/live/*.test.mjs\"",
    "verify:model": "node --env-file-if-exists=.env scripts/verify-model.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@openai/agents": "0.21.0",
    "ajv": "8.20.0",
    "canonicalize": "5.1.0",
    "express": "5.3.0",
    "openai": "7.47.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "yaml": "2.9.1"
  }
}
