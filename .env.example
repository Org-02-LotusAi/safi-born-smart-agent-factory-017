ANTHROPIC_API_KEY=your-anthropic-api-key-here
LLM_BASE_URL=https://api.anthropic.com/v1/
LLM_MODEL=claude-sonnet-5-5

# Server. Choose your own passcodes; if unset in dev, random ones are printed once at start.
CANDIDATE_PASSCODE=choose-a-job-seeker-passcode
TRAINER_PASSCODE=choose-a-trainer-passcode
# SESSION_SECRET=   (optional; generated into data/ if unset)
# SAFI_MODE=office  (Office: all training routes are refused)
# PORT=8017
# HOST=127.0.0.1
# SAFI_DATA_DIR=   (default ./data)
# COOKIE_SECURE=1   (set when served over HTTPS)
# TRUST_PROXY=false   (default). Behind ONE reverse proxy / load balancer (AWS ALB) set TRUST_PROXY=1; also accepts loopback. Never "true".

