{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://safi.example/schemas/knowledge.meta.schema.json",
  "title": "SAFI knowledge document metadata (front matter)",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "version", "title", "author", "date", "source"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$" },
    "version": { "type": "string", "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$" },
    "title": { "type": "string", "minLength": 1 },
    "author": { "type": "string", "minLength": 1 },
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "source": { "type": "string", "minLength": 1 }
  }
}
