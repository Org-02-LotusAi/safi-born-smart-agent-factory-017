{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://safi.example/schemas/skill.meta.schema.json",
  "title": "SAFI Skill contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "id", "version", "title", "purpose", "inputs", "outputs", "steps", "constraints", "digest"],
  "properties": {
    "kind": { "const": "skill" },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$" },
    "version": { "type": "string", "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$" },
    "title": { "type": "string", "minLength": 1 },
    "purpose": { "type": "string", "minLength": 1 },
    "inputs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/field" } },
    "outputs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/field" } },
    "steps": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "constraints": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  },
  "$defs": {
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "description"],
      "properties": {
        "name": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9]*$" },
        "description": { "type": "string", "minLength": 1 }
      }
    }
  }
}
